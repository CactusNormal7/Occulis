---
import { contentFor, type Locale } from "../i18n";
import SectionBar from "./SectionBar.astro";
import WorkInProgress from "./WorkInProgress.astro";

interface Props {
  locale: Locale;
}

const { board } = contentFor(Astro.props.locale);
const pad = (n: number): string => String(n).padStart(2, "0");
---

{/*
  Le plateau joué au défilement : la scène reste épinglée pendant que la page défile, et
  chaque cran de défilement avance l'horloge du scénario (`island/board.ts`, mode `manual`).
  Le rail du haut montre où l'on en est parmi les étapes. Les chiffres du panneau sont
  fictifs : la vraie démonstration viendra plus tard, le ruban de chantier le dit.
  Sans JavaScript ou sous « mouvement réduit », rien n'est épinglé : une image fixe, puis
  les étapes l'une sous l'autre.
*/}
<section class="section scrub" id="plateau" aria-labelledby="board-title" tabindex="-1" data-scrub>
  <div class="frame">
    <SectionBar id="board-title" label={board.label} />
  </div>
  <div class="scrub__track">
    <div class="scrub__stage">
      <div class="frame scrub__inner">
        <ol class="scrub__rail" aria-hidden="true">
          {
            board.steps.map((step, index) => (
              <li class="scrub__mark" data-mark={index}>
                <span class="scrub__mark-index">{pad(index + 1)}</span>
                <span class="scrub__mark-word">{step.word}</span>
              </li>
            ))
          }
        </ol>

        <WorkInProgress {...board.wip}>
        <div class="scrub__view">
          <div class="board" data-board>
            <picture>
              <source
                type="image/avif"
                srcset="/images/board-summit-720.avif 720w, /images/board-summit-1440.avif 1440w"
                sizes="(min-width: 1280px) 1152px, 100vw"
              />
              <img
                class="board__poster"
                src="/images/board-summit-720.webp"
                srcset="/images/board-summit-720.webp 720w, /images/board-summit-1440.webp 1440w"
                sizes="(min-width: 1280px) 1152px, 100vw"
                width="1440"
                height="720"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </picture>
            <canvas class="board__canvas" role="img" aria-label={board.boardLabel}></canvas>
          </div>


          <ol class="scrub__steps">
            {
              board.steps.map((step, index) => (
                <li class="scrub__step" data-step={index}>
                  <div class="scrub__caption">
                    <h3 class="scrub__word">
                      <span class="scrub__index" aria-hidden="true">
                        {pad(index + 1)}/{pad(board.steps.length)}
                      </span>
                      {step.word}
                    </h3>
                    <p class="scrub__text">{step.text}</p>
                  </div>
                  <div class="scrub__data">
<dl class="scrub__list">
                    {step.data.map((item) => (
                      <div class="scrub__datum">
                        <dt>{item.label}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                                      </dl>
<p class="scrub__note">{board.wipNote}</p>
</div>
                </li>
              ))
            }
          </ol>
        </div>

        </WorkInProgress>

        <div class="scrub__foot" aria-hidden="true">
          <p class="scrub__hint">
            <span class="scrub__arrow"></span>
            <span class="scrub__hint-go">{board.hint}</span>
            <span class="scrub__hint-end">{board.end}</span>
          </p>
          <p class="scrub__counter"><span class="scrub__counter-now">01</span> / {pad(board.steps.length)}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { FRAMES } from "../island/script";

  const section = document.querySelector<HTMLElement>("[data-scrub]");
  const host = section?.querySelector<HTMLElement>("[data-board]");
  const canvas = host?.querySelector("canvas");
  const track = section?.querySelector<HTMLElement>(".scrub__track");
  const marks = [...(section?.querySelectorAll<HTMLElement>("[data-mark]") ?? [])];
  const counter = section?.querySelector<HTMLElement>(".scrub__counter-now");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (section && host && canvas && track) {
    // L'étape affichée, d'après l'image du scénario : départ, approche, sommet, souvenir.
    const stepOf = (frame: number): number =>
      frame < FRAMES.fog ? 0 : frame < FRAMES.summit ? 1 : frame < FRAMES.ghosts ? 2 : 3;

    const show = (step: number, progress: number) => {
      if (section.dataset.step !== String(step)) {
        section.dataset.step = String(step);
        marks.forEach((mark, index) => {
          mark.classList.toggle("is-done", index < step);
          mark.classList.toggle("is-current", index === step);
        });
        if (counter) counter.textContent = String(step + 1).padStart(2, "0");
      }
      section.style.setProperty("--scrub", progress.toFixed(4));
      section.classList.toggle("is-ending", progress > 0.96);
    };

    const start = () => {
      void import("../island/board").then(({ mountBoard }) => {
        const pinned = !reduced.matches;
        const control = mountBoard(host, canvas, { manual: pinned });
        if (control === undefined || !pinned) return;
        let pending = false;
        const update = () => {
          pending = false;
          const rect = track.getBoundingClientRect();
          const span = rect.height - window.innerHeight;
          const progress = span <= 0 ? 0 : Math.min(1, Math.max(0, -rect.top / span));
          // Un peu de marge aux deux bouts : le premier et le dernier état se lisent.
          const now = Math.min(1, Math.max(0, (progress - 0.04) / 0.88)) * control.total;
          control.seek(now);
          show(stepOf(control.frameAt(now)), progress);
        };
        const request = () => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(update);
        };
        window.addEventListener("scroll", request, { passive: true });
        window.addEventListener("resize", request);
        update();
      });
    };
    if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 1500 });
    else setTimeout(start, 200);
  }
</script>
