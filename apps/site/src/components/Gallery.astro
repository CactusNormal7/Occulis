---
import { contentFor, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { gallery } = contentFor(Astro.props.locale);
---

<section class="section" aria-labelledby="gallery-title">
  <div class="frame">
    <h2 id="gallery-title" class="section__title">{gallery.title}</h2>
    <p class="section__intro">{gallery.intro}</p>
    <ul class="gallery">
      {
        gallery.items.map((item) => (
          <li>
            <figure class="shot">
              <picture>
                <source
                  type="image/avif"
                  srcset={`/images/board-${item.image}-720.avif 720w, /images/board-${item.image}-1440.avif 1440w`}
                  sizes="(min-width: 960px) 33vw, 100vw"
                />
                <img
                  src={`/images/board-${item.image}-720.webp`}
                  srcset={`/images/board-${item.image}-720.webp 720w, /images/board-${item.image}-1440.webp 1440w`}
                  sizes="(min-width: 960px) 33vw, 100vw"
                  width="720"
                  height="360"
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <figcaption>{item.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
