---
import { contentFor, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { site } = contentFor(Astro.props.locale);
---

<header class="header">
  {/* La progression de lecture : une ligne d'os qui avance avec le défilement. */}
  <div class="progress" aria-hidden="true"></div>
  <div class="frame header__row">
    <a class="wordmark" href="/" aria-label={site.homeLabel}>Occulis</a>
    <nav class="nav" aria-label={site.nav.label}>
      <ul>
        {
          site.nav.items.map((item) => (
            <li>
              <a href={`/${item.href}`}>{item.text}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button button--quiet" href="/#beta">{site.headerCta}</a>
  </div>
</header>
