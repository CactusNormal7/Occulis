---
import { contentFor, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { site } = contentFor(Astro.props.locale);
---

<header class="header">
  <div class="frame header__row">
    <a class="wordmark" href="/" aria-label={site.homeLabel}>Occulis</a>
    <a class="button button--quiet" href="/#beta">{site.headerCta}</a>
  </div>
</header>
