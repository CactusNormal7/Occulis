---
import { contentFor, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { differences } = contentFor(Astro.props.locale);
---

<section class="section" aria-labelledby="differences-title">
  <div class="frame">
    <h2 id="differences-title" class="section__title">{differences.title}</h2>
    <dl class="differences">
      {
        differences.items.map((item) => (
          <div class="difference">
            <dt class="difference__term">{item.term}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
