# Copier en `.dev.vars` pour `wrangler dev`. Ce fichier n'est pas versionné.
#
# En déployé, ces valeurs sont des secrets Wrangler, pas des variables :
#   wrangler secret put AUTH_SECRET --env production
AUTH_SECRET="un-secret-local-quelconque-mais-long"

# Sans clé Resend, les messages de vérification et de réinitialisation sont
# journalisés dans la console au lieu d'être envoyés : le lien reste cliquable.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Occulis <no-reply@0kl.fr>"
# MAIL_REPLY_TO="contact@0kl.fr"

# Connexion Google (client « dev », docs/setup.md section 7). Sans les deux, le bouton
# « Continuer avec Google » n'apparaît pas. URI de retour à déclarer chez Google :
#   http://localhost:8787/api/auth/callback/google
# GOOGLE_CLIENT_ID="…apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-…"

# Le contrôle des mots de passe ayant fuité interroge Have I Been Pwned (5 caractères
# d'empreinte seulement). `off` le coupe, pour travailler hors ligne.
# PASSWORD_BREACH_CHECK="off"
