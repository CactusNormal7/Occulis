{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    // Les aperçus de `.design-sync/previews/` vivent hors de tout paquet : ils reçoivent
    // `@occulis/ui` et Vue de cette application, comme le fait `vite.config.ts` au build.
    "paths": {
      "@occulis/ui": ["../../packages/ui/src/index.ts"],
      "@occulis/i18n": ["../../packages/i18n/src/index.ts"],
      "vue": ["./node_modules/vue"]
    }
  },
  // Les aperçus sont montés par le design system du back-office : ils sont vérifiés avec le client.
  "include": ["src", "lab", "../../.design-sync/previews/**/*.vue"],
  "exclude": ["**/* 2.*", "../../.design-sync/**/* 2.*"]
}
