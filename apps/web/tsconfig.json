{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // `lab/main.ts` monte les aperçus de la charte par leur chemin `.tsx` (packages/ui).
    "allowImportingTsExtensions": true
  },
  "include": ["src", "lab"]
}
