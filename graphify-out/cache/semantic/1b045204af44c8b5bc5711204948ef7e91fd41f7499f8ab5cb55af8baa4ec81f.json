type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_apps_web", "label": "apps/web (Vite + PixiJS rendering)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_core_determinism_invariant", "label": "packages/core strict determinism invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Math.random/Date.now/clock in core: replaying an action log must reconstruct the exact game state for persistence and server-side reconstruction; any non-determinism would silently break this."}, {"id": "claude_los_symmetry", "label": "LOS symmetry-by-construction", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "los.ts canonicalizes endpoint order before Bresenham raycast so line-of-sight is symmetric by construction; must not be broken."}, {"id": "claude_fog_structural", "label": "Fog of war is structural, not applicative", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The match Durable Object holds GameState and both PlayerKnowledge and sends each player only their own viewFor(); a client cannot receive what the DO never sends, so fog cannot be bypassed via devtools."}, {"id": "claude_do_hibernation", "label": "Durable Object must hibernate", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DO holding an open WebSocket without hibernating costs ~20000x more with no functional difference; must be covered by a dedicated test."}, {"id": "claude_matchmaking_do", "label": "Global matchmaking Durable Object", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second, global DO serves as the matchmaking queue; its single-threading eliminates double pairing by construction."}, {"id": "claude_d1_source_of_truth", "label": "D1 action log is the source of truth", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The DO's in-memory state is a reconstructible cache; the D1 action log is authoritative, relying entirely on core's determinism invariant."}, {"id": "claude_ruleset_versioning", "label": "Rules versioned per match, not per connection", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A match started under ruleset v3 finishes under v3; since the client target is a downloadable Electron app with unlimited thinking time, matches span deployments and old clients embed old core."}, {"id": "claude_branch_environments", "label": "One branch = one full hosted environment", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted branches are explicitly selected via .github/deploy-environments.json, never auto-deployed, so environment population is decided rather than incidental; a branch touching core changes rules and must not be tested against main's."}, {"id": "claude_theme_color_centralization", "label": "src/theme.ts sole color-value file", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/web/src/theme.ts is the only client file allowed to contain a color value, enforced mechanically by an ESLint rule rather than convention."}, {"id": "claude_graphify_rules", "label": "graphify usage rules (root CLAUDE.md)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_occulis_project", "target": "claude_design_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_occulis_project", "target": "claude_architecture_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_occulis_project", "target": "claude_costs_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_occulis_project", "target": "claude_setup_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_occulis_project", "target": "claude_implementation_notes_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_occulis_project", "target": "claude_technical_docs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_occulis_project", "target": "claude_packages_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "c