{
  "name": "@occulis/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "La charte graphique d'Occulis en composants Vue : tokens, briques d'interface, icônes au trait.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./critical": "./src/critical.ts",
    "./styles.css": "./src/styles.css",
    "./wip.css": "./src/wip.css",
    "./reveal": "./src/window-reveal.ts",
    "./lab": "./src/lab/index.ts",
    "./lab.css": "./src/lab/lab.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && node scripts/bundle-css.mjs",
    "tokens": "node --experimental-strip-types scripts/build-tokens.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "dependencies": {
    "@occulis/i18n": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
