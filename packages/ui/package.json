{
  "name": "@occulis/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "La charte graphique d'Occulis en composants React : tokens, briques d'interface, icônes au trait.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./critical": "./src/critical.ts",
    "./styles.css": "./src/styles.css",
    "./reveal": "./src/window-reveal.ts",
    "./lab": "./src/lab/index.ts",
    "./lab.css": "./src/lab/lab.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "tokens": "node --experimental-strip-types scripts/build-tokens.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@occulis/i18n": "workspace:*"
  }
}
