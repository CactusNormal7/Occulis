{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true
  },
  // Doublons créés par la synchronisation iCloud du Bureau (« fichier 2.ts ») : ignorés
  // par git, ils restaient compilés en local et y faisaient échouer le typecheck.
  "exclude": ["**/* 2.*", "**/node_modules", "**/dist"]
}
